# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://orderapp:orderapp@localhost:5434/orderapp?schema=public"

# ---------------------------------------------------------------------------
# Auth
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ---------------------------------------------------------------------------
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
SESSION_MAX_AGE_SECONDS=28800

# ---------------------------------------------------------------------------
# Default admin (used by `npm run db:seed`)
# ---------------------------------------------------------------------------
ADMIN_EMAIL="admin@snackshop.test"
ADMIN_PASSWORD="Admin123!change"
ADMIN_NAME="Shop Owner"

# ---------------------------------------------------------------------------
# Business identity (shown in the customer header)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BUSINESS_NAME="Bahala ka na"

# ---------------------------------------------------------------------------
# Image storage. Swap the driver without touching application code.
# STORAGE_DRIVER = local | cloudinary | s3
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"

# --- local ---
LOCAL_UPLOAD_DIR="public/uploads"
LOCAL_PUBLIC_PREFIX="/uploads"

# --- cloudinary ---
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# CLOUDINARY_FOLDER="orderapp"

# --- s3 / DigitalOcean Spaces / R2 (requires: npm i @aws-sdk/client-s3) ---
# S3_BUCKET=""
# S3_REGION="us-east-1"
# S3_ENDPOINT="https://sgp1.digitaloceanspaces.com"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL="https://my-bucket.sgp1.cdn.digitaloceanspaces.com"
# S3_FORCE_PATH_STYLE="false"

# ---------------------------------------------------------------------------
# Rate limiting for public order submission
# ---------------------------------------------------------------------------
ORDER_RATE_LIMIT_MAX=8
ORDER_RATE_LIMIT_WINDOW_SECONDS=600
